{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "short_name": "PWA Kourt's",
  "lang": "pt-BR",
  "name": "Kourt's",
  "description": "Modelo de reserva de quadras em Bootstrap, SPA e PWA",
  "scope": "./",
  "icons": [
    {
      "src": "imagens/logo-kourts.png",
      "sizes": "512x512",
